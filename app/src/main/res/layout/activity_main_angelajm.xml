<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- JUDUL ATAS -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="GAJI KARYAWAN"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:background="#D3D3D3"
        android:textColor="#555555" />

    <!-- BARIS 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp">

        <Button
            android:id="@+id/btnGajiAngelajm"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="GAJI PEGAWAI"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:drawableTop="@drawable/ic_baseline_wallet_24"
            android:drawablePadding="8dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnPetunjukAngelajm"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="PETUNJUK"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:drawableTop="@drawable/ic_baseline_lightbulb_24"
            android:drawablePadding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- BARIS 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnTentangAngelajm"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="TENTANG"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:drawableTop="@drawable/ic_baseline_info_24"
            android:drawablePadding="8dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnExitAngelajm"
            android:layout_width="0dp"
            android:layout_height="110dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="EXIT"
            android:textColor="#FFFFFF"
            android:backgroundTint="#6200EE"
            android:drawableTop="@drawable/ic_baseline_logout_24"
            android:drawablePadding="8dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- FOOTER -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="40dp"
        android:text="www.sandrio.com"
        android:gravity="center"
        android:background="#D3D3D3"
        android:textColor="#555555" />

</LinearLayout>