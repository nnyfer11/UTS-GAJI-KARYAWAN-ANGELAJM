<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PETUNJUK PENGGUNAAN" android:textStyle="bold" android:textSize="20sp" android:gravity="center" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="1. Jalankan Aplikasi\n2. Pilih Icon Gaji Pegawai untuk menjalankan simulasi\n3. Pilih petunjuk penggunaan untuk cara penggunaan\n4. Pilih Tentang Aplikasi untuk informasi tentang aplikasi\n5. Pilih Exit untuk keluar aplikasi" android:textSize="16sp" />
    <Button android:id="@+id/btnKembaliPetunjukAngelajm" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kembali" android:layout_marginTop="30dp" />
</LinearLayout>